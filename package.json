{
  "name": "chaos-on-front",
  "version": "0.1.0",
  "type": "module",
  "description": "Chaos Monkey for the frontend: randomly inject network delays, API errors, bad data and component crashes into your React app during development.",
  "license": "MIT",
  "author": "Ridho Wahyu Darmawan <ridhozedd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Porterfrag/chaos_on_front.git"
  },
  "keywords": ["chaos", "chaos-monkey", "react", "testing", "resilience", "devtools", "fetch", "error-boundary"],
  "sideEffects": false,
  "main": "./dist-lib/index.cjs.js",
  "module": "./dist-lib/index.es.js",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/index.es.js",
      "require": "./dist-lib/index.cjs.js"
    }
  },
  "files": ["dist-lib"],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "zustand": ">=5"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:lib": "vite build --config vite.lib.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "prepublishOnly": "npm run typecheck && npm run build:lib"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.4",
    "zustand": "^5.0.2"
  }
}
